# Firebase Client Configuration for Sahyatri
# Copy to .env.local and replace with your project values from the Firebase Console:
# https://console.firebase.google.com/project/_/settings/general

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDemoKeySahyatri1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sahyatri-travel-os.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sahyatri-travel-os
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sahyatri-travel-os.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=109283746501
NEXT_PUBLIC_FIREBASE_APP_ID=1:109283746501:web:abcdef1234567890

# Google Gemini API Key for Live AI Reasoning (Optional Fallback)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# 1. Cloud AI Brain (Groq Llama-3.3-70B - High speed, No Gemini / No Ollama required)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Live Internet Search API (Fetches live web pages, ticket prices, restaurant hours)
# Get your free key at: https://app.tavily.com (1,000 free searches/month)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# 3. Live Weather Telemetry API (Real-time weather, humidity, and wind)
# Get your free key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 4. Live Places, Restaurants & Emergency Hospitals API
# Get your free key at: https://myprojects.geoapify.com
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# 5. Live Currency Exchange Rate API (Live INR, JPY, USD, EUR rates)
# Get your free key at: https://app.exchangerate-api.com
EXCHANGERATE_API_KEY=your_exchangerate_api_key_here
